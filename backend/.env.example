# Flask session signing key — set a long random value in production.
SECRET_KEY=change-me-to-a-random-secret

# Where the SQLite DB file and uploaded media are stored.
# On Railway, set this to the mount path of an attached Volume
# (e.g. /data) so data survives redeploys.
DATA_DIR=

# Optional: use Postgres instead of SQLite (Railway sets this
# automatically when you attach a Postgres plugin).
DATABASE_URL=

# Default admin account created on first boot if it doesn't exist yet.
ADMIN_USERNAME=System_Admin
ADMIN_EMAIL=admin@media.com
ADMIN_PASSWORD=change-me

# No email/SMS provider is wired up, so OTPs are printed to the server
# log. With DEMO_MODE=true (default) they're also returned in the API
# response so the deployed app is usable from a browser alone.
DEMO_MODE=true

# Comma-separated list of extra CORS origins (only needed if the
# frontend is hosted on a different origin than the API).
CORS_ORIGINS=

MAX_CONTENT_LENGTH=157286400
PORT=8080
